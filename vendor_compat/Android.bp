// Compatibility Shims for v31 (Properly named to avoid conflicts)

cc_prebuilt_library_shared {
    name: "libbinder-v31",
    vendor: true,
    target: {
        android_arm64: {
            srcs: ["v31/lib64/libbinder.so"],
        },
        android_arm: {
            srcs: ["v31/lib/libbinder.so"],
        },
    },
    compile_multilib: "both",
    check_elf_files: false,
}

cc_prebuilt_library_shared {
    name: "libhidlbase-v31",
    vendor: true,
    target: {
        android_arm64: {
            srcs: ["v31/lib64/libhidlbase.so"],
        },
        android_arm: {
            srcs: ["v31/lib/libhidlbase.so"],
        },
    },
    compile_multilib: "both",
    check_elf_files: false,
}

cc_prebuilt_library_shared {
    name: "libutils-v31",
    vendor: true,
    target: {
        android_arm64: {
            srcs: ["v31/lib64/libutils.so"],
        },
        android_arm: {
            srcs: ["v31/lib/libutils.so"],
        },
    },
    compile_multilib: "both",
    check_elf_files: false,
}

cc_prebuilt_library_shared {
    name: "liblog-v31",
    vendor: true,
    target: {
        android_arm64: {
            srcs: ["v31/lib64/liblog.so"],
        },
    },
    compile_multilib: "64",
    check_elf_files: false,
}

cc_prebuilt_library_shared {
    name: "libstagefright_bufferqueue_helper-v31",
    vendor: true,
    target: {
        android_arm64: {
            srcs: ["v31/lib64/libstagefright_bufferqueue_helper.so"],
        },
    },
    compile_multilib: "64",
    check_elf_files: false,
}

// VNDK compat for vendor blobs (v32)
cc_prebuilt_library_shared {
    name: "android.system.keystore2-V1-ndk_platform",
    vendor: true,
    target: {
        android_arm64: {
            srcs: ["v32/lib64/android.system.keystore2-V1-ndk_platform.so"],
        },
    },
    compile_multilib: "64",
    check_elf_files: false,
}
