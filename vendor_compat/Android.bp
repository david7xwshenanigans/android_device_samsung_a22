// VNDK compat for vendor blobs (v31)

cc_prebuilt_library_shared {
    name: "libbinder-v31",
    vendor: true,
    target: {
        android_arm64: {
            srcs: ["v31/lib64/libbinder.so"],
        },
        android_arm: {
            srcs: ["v31/lib/libbinder.so"],
        },
    },
    compile_multilib: "both",
    check_elf_files: false,
}

